NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-at-least-32-chars
# 32-byte AES-256-GCM key for encrypting judge PINs at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_ENCRYPTION_KEY=your-64-char-hex-key
# Shared secret for the /api/keepalive cron endpoint (Vercel Cron + GitHub Actions).
# REQUIRED in production — the endpoint fails closed without it. Optional locally.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
